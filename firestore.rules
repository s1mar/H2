rules_version = '2';

// Kin — Family Health & Emergency Reach-In
// Two mutually-paired users share vitals and exchange WebRTC signaling.
// Rules are aligned to the actual client paths in the sync/ package:
//   users/{uid}                      -> fcmToken (owner only; Admin SDK reads for relay)
//   pairings/{uid}.partnerUid        -> mutual pairing pointers
//   partners/{uid}/latest/latest     -> vitals snapshot
//   signaling/{room}[/messages/*]    -> room = the two uids sorted + joined by "_"
//   outbound_pushes/{id}             -> emergency-push relay request (Cloud Function)
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    function pairPtr(uid) {
      return get(/databases/$(database)/documents/pairings/$(uid)).data.partnerUid;
    }
    // True when uid and the caller point at each other via pairings/*.
    function isPairedWith(uid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/pairings/$(request.auth.uid))
        && exists(/databases/$(database)/documents/pairings/$(uid))
        && pairPtr(request.auth.uid) == uid
        && pairPtr(uid) == request.auth.uid;
    }

    // Own profile / FCM token. Only the owner touches it; the relay function
    // uses the Admin SDK, which bypasses these rules.
    match /users/{uid} {
      allow read, write: if isSelf(uid);
    }

    // Pairing pointers. A user always controls their own doc. They may write the
    // PARTNER's pointer back to themselves ONLY if that partner is not yet paired
    // (doc absent) or already points at them (re-pair / refresh). This blocks a
    // third party from overwriting an existing pairing and hijacking vitals access.
    match /pairings/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid)
        || (isSignedIn()
            && request.resource.data.partnerUid == request.auth.uid
            && (!exists(/databases/$(database)/documents/pairings/$(uid))
                || get(/databases/$(database)/documents/pairings/$(uid)).data.partnerUid
                     == request.auth.uid));
    }

    // Vitals snapshot: owner writes; owner and paired partner read.
    match /partners/{uid}/latest/{snapshot} {
      allow read: if isSelf(uid) || isPairedWith(uid);
      allow write: if isSelf(uid);
    }

    // WebRTC signaling. The room id embeds both uids ("uidA_uidB", sorted), so
    // access is granted iff the caller's uid is one of the room's two halves.
    match /signaling/{room} {
      allow read, write: if isSignedIn() && request.auth.uid in room.split('_');
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid in room.split('_');
      }
    }

    // Emergency-push relay requests: a caller may create one addressed from
    // themselves; only the Admin SDK (Cloud Function) reads/clears them.
    match /outbound_pushes/{pushId} {
      allow create: if isSignedIn()
        && request.resource.data.callerId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
